{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "rewrites": [
    {
      "source": "/api/photos/:path*",
      "destination": "/api/photos/[...path]"
    },
    {
      "source": "/api/contracts/:path*",
      "destination": "/api/contracts/[...path]"
    }
  ],
  "crons": [
    {
      "path": "/api/contract/write?cron=dailySweep",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/admin/reset?cron=monthRollover",
      "schedule": "0 15 * * *"
    }
  ]
}
